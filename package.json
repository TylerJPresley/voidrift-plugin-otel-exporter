{
  "name": "@voidrift/plugin-otel-exporter",
  "version": "0.1.0",
  "description": "VoidRift OpenTelemetry exporter — maps the core's neutral ObsRecord onto OTel GenAI spans and ships them to any OTLP backend.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "@voidrift/core": "^0.1.0"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.43.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@voidrift/core": "^0.1.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "typescript-eslint": "8.71.1"
  },
  "voidrift": {
    "kind": "plugin",
    "plugin": true,
    "description": "Maps each neutral ObsRecord onto an OpenTelemetry GenAI span and ships it to any OTLP backend (otel-exporter-blueprint §1)."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TylerJPresley/voidrift-plugin-otel-exporter.git"
  },
  "bugs": {
    "url": "https://github.com/TylerJPresley/voidrift-plugin-otel-exporter/issues"
  },
  "homepage": "https://github.com/TylerJPresley/voidrift-plugin-otel-exporter#readme",
  "keywords": [
    "voidrift",
    "opentelemetry",
    "exporter",
    "maps",
    "core"
  ],
  "publishConfig": {
    "access": "public"
  }
}
